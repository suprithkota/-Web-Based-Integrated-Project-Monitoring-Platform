# =============================================================================
# ProjectPulse AI — Environment Configuration Template (.env.example)
# Copy to .env and configure for your environment (never commit real .env files)
# =============================================================================

# Flask Application & Security
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=replace-with-cryptographically-secure-random-key-in-production

# Database Configuration (SQLite default for dev; PostgreSQL for production)
# SQLite: sqlite:///instance/project_monitoring.db
# PostgreSQL: postgresql://app_user:strong_password@localhost:5432/projectpulse_db
DATABASE_URL=sqlite:///instance/project_monitoring.db

# Session Security (Set to true when serving over HTTPS in production)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Rate Limiting (Memory storage for dev; redis://localhost:6379 for production)
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per day;50 per hour

# Email Service Configuration
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@projectpulse.gov.in
APP_BASE_URL=http://127.0.0.1:5000

# Optional External AI API Key (Application defaults to deterministic DB rule-engine if absent)
AI_API_KEY=
AI_API_ENDPOINT=
AI_MODEL_NAME=gemini-1.5-flash

